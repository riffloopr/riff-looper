{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Riff Looper",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "de",
  "author": "Ulrich Hofer",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["looper.css"],
      "run_at": "document_idle"
    }
  ]
}
